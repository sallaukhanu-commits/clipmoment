# Brand (configurable)
NEXT_PUBLIC_APP_NAME="ClipMoment AI"

# Supabase. If unset, the app runs in clearly labeled DEMO MODE with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Limits
NEXT_PUBLIC_MAX_UPLOAD_MB=2048
NEXT_PUBLIC_MAX_DURATION_MIN=180

# Worker (Python) - see worker/.env.example
