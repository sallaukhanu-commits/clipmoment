# Worker config. Requires ffmpeg and ffprobe on PATH.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=media

# Provider selection (interchangeable; see providers.py)
TRANSCRIBER=openai          # openai | (add your own)
OPENAI_API_KEY=
LLM=anthropic               # anthropic | (add your own)
ANTHROPIC_API_KEY=
LLM_MODEL=                  # set to a current model ID from your provider's docs

# Limits
MAX_DURATION_MIN=180
POLL_INTERVAL_SEC=5
